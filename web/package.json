{
  "name": "carburant-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "captures": "playwright test --config playwright.captures.config.ts --trace off",
    "generer-client": "openapi-typescript openapi.json -o app/api/genere/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/petrona": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "nuxt": "4.6.4",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.4.0",
    "@playwright/test": "1.65.1",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "happy-dom": "21.0.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
