# Copier en .env et completer. Le .env n'est JAMAIS commite.

# --- base de donnees ---
POSTGRES_USER=carburant
POSTGRES_PASSWORD=change-moi-en-local
POSTGRES_DB=carburant
POSTGRES_HOST=db
POSTGRES_PORT=5432
# URL construite par les services a partir des variables ci-dessus
DATABASE_URL=postgresql://carburant:change-moi-en-local@db:5432/carburant

# --- ETL ---
# User-Agent qui identifie le projet aupres des sources publiques
ETL_USER_AGENT=carburant/0.1 (+https://github.com/bapotuse/carburant)
# Retention des fichiers bruts sur disque, en jours
ETL_RETENTION_JOURS=14
# La planification n'est pas ici : elle est dans infra/cron/carburant.cron, lu par
# supercronic en production. Une table cron se relit en revue ; une variable
# d'environnement dans un .env non versionne, non.

# --- API ---
API_ORIGINES_AUTORISEES=http://localhost:3000
API_CACHE_PRIX_SECONDES=900
API_CACHE_GEOCODE_SECONDES=86400
API_CACHE_TENDANCES_SECONDES=3600
# Age maximal de la derniere collecte reussie avant que /v1/sante renvoie 503, en minutes
API_SANTE_AGE_MAX_MINUTES=60
# Limitation de debit, par adresse IP et par minute. /v1/sante en est exempte.
# Le site fait trois ou quatre requetes par page : un humain ne s'en approche pas.
API_LIMITE_PAR_MINUTE=120

# --- Front ---
NUXT_PUBLIC_API_BASE=http://localhost:8000

# --- MCP ---
CARBURANT_API_BASE=http://localhost:8000

# --- construction derriere un proxy sortant (rare) ---
# Laisser vide sur une machine normale. Mettre `host` quand le conteneur de build
# doit joindre un proxy HTTPS ecoutant sur la machine hote ; deposer alors aussi le
# certificat du proxy dans infra/docker/ca/ (voir le README de ce dossier).
# BUILD_NETWORK=host

# --- production (renseigne uniquement dans le .env du VPS, droits 600) ---
# Le nom de domaine du site, sans schema ni barre oblique. Caddy obtient le
# certificat pour ce nom ; le front s'en sert pour l'adresse publique de l'API.
# CARBURANT_DOMAINE=carburant.exemple.fr
# Registre et etiquette des images. Le deploiement les passe lui-meme ; ces valeurs
# ne servent qu'a relancer la pile a la main sur le VPS.
# REGISTRE=ghcr.io/bapotuse
# TAG=main
# Image PostGIS. A changer en imresamu/postgis:18-3.6-alpine si `uname -m` sur le
# VPS repond aarch64 : postgis/postgis ne publie pas d'image arm64.
# IMAGE_DB=postgis/postgis:18-3.7
# Dead man's switch de la collecte (Jalon 6).
# HEALTHCHECK_URL=
